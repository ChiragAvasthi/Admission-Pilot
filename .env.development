# ==========================================
# AdmissionPilot - Development Environment
# ==========================================

# --- API Server ---
ENVIRONMENT=development
LOG_LEVEL=DEBUG
HOST=0.0.0.0
PORT=8000

# --- Security ---
# Secret key for JWT/Sessions (Use a simple string for dev)
SECRET_KEY=dev_secret_key_12345
# Allowed CORS origins (Wildcard allowed for local frontend dev)
CORS_ORIGINS="*"

# --- Database ---
# Local SQLite for easy development
DATABASE_URL=sqlite+aiosqlite:///./admission_pilot.db

# --- AI & Vector Store ---
# Using local host's Ollama instance. If running backend in Docker, 
# host.docker.internal allows Docker to talk to host's Ollama.
OLLAMA_BASE_URL=http://host.docker.internal:11434
CHROMADB_DIR=./company_workspaces/chroma_db
DEFAULT_LLM_MODEL=qwen3:8b

# --- Storage ---
# Local directory for file uploads
UPLOAD_DIR=./company_workspaces
MAX_UPLOAD_SIZE_MB=50
