# ==========================================
# AdmissionPilot - Production Environment
# ==========================================

ENVIRONMENT=production
LOG_LEVEL=WARNING
HOST=0.0.0.0
PORT=8000

# --- Security (MUST CHANGE) ---
# Generate a secure 64-character hex key for production
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING
# Restrict CORS to actual frontend domain
CORS_ORIGINS="https://your-production-domain.com,https://app.your-production-domain.com"

# --- Database ---
# Use a production-grade database like Postgres
DATABASE_URL=postgresql+asyncpg://postgres:secure_password@db_host:5432/admission_pilot

# --- AI & Vector Store ---
# Point to a dedicated Ollama cluster or high-availability local instance
OLLAMA_BASE_URL=http://host.docker.internal:11434
CHROMADB_DIR=/app/data/chroma_db
DEFAULT_LLM_MODEL=qwen3:8b

# --- Storage ---
UPLOAD_DIR=/app/data/workspaces
MAX_UPLOAD_SIZE_MB=100
